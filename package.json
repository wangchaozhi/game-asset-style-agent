{
  "name": "game-asset-agent",
  "version": "1.12.0",
  "description": "AI agent that generates style-consistent game assets from reference images",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:prod": "node dist/server.js",
    "typecheck": "tsc",
    "test": "node --import tsx --test --test-reporter=spec \"test/**/*.test.ts\"",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "coverage": "node --import tsx --enable-source-maps --test --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='src/**/types.ts' --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=85 \"test/**/*.test.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "multer": "^2.4.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
