# Claude（Agent 大脑）。也可以用 `ant auth login` 登录，SDK 会自动读取
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
AGENT_MAX_TURNS=40

# 图像模型（至少配置一个；都不配时只能用 Mock 占位图）
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# demo = 不调用 Claude，用脚本跑一遍流水线（用于无 key 时体验界面）
AGENT_MODE=
PORT=5173
