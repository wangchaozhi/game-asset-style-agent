# Claude（Agent 大脑）。也可以用 `ant auth login` 登录，SDK 会自动读取
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
AGENT_MAX_TURNS=40

# 图像模型（至少配置一个；都不配时只能用 Mock 占位图）
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# 图像接口遇到 429 / 5xx / 网络错误时的重试次数（指数退避，遵循 Retry-After）
IMAGE_MAX_RETRIES=3

# 用量面板的费用估算。Claude 按官方单价内置；如需覆盖，填「输入,输出,缓存写,缓存读」美元/百万 tokens
CLAUDE_PRICE=
# 图像单价（美元/张），不填则只统计调用次数
IMAGE_PRICE_OPENAI=
IMAGE_PRICE_GEMINI=

# 访问令牌：设置后打开页面需先输入它登录（公网部署务必设置）；API 也可用 Authorization: Bearer <令牌>
ACCESS_TOKEN=

# demo = 不调用 Claude，用脚本跑一遍流水线（用于无 key 时体验界面）
AGENT_MODE=
PORT=5173
